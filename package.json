{
  "name": "turned",
  "version": "0.34.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:turned-client dev:turned-server",
    "db:up": "npm run db:up --workspace=packages/website",
    "db:migrate": "npm run db:migrate --workspace=packages/website",
    "db:generate": "npm run db:generate --workspace=packages/website",
    "dev:website": "npm run dev --workspace=packages/website",
    "dev:server": "npm run dev --workspace=packages/game-server",
    "dev:biome-editor": "npm run dev --workspace=packages/biome-editor-server",
    "build:server": "npm run build --workspace=packages/game-server",
    "test:game-client": "npm run test --workspace=packages/game-client",
    "test:game-server": "npm run test --workspace=packages/game-server",
    "depcruiser": "depcruise ./packages --exclude \"^packages/build\" --include-only \"packages\" --output-type dot | dot -T svg > dependency-graph.svg",
    "dev:legacy": "npm-run-all --parallel dev:website dev:server dev:biome-editor",
    "dev:turned-client": "npm run dev:turned --workspace=packages/website",
    "dev:turned-server": "npm run dev:turned --workspace=packages/game-server",
    "build": "npm run build:turned --workspace=packages/game-server && npm run build --workspace=packages/website",
    "test:turned": "npm run test --workspace=packages/game-shared -- --run src/turned && npm run test --workspace=packages/game-server -- --run src/turned && vitest run packages/website/src/turned --config packages/game-client/vitest.config.ts",
    "start:turned-server": "npm run start:turned --workspace=packages/game-server",
    "test:e2e": "playwright test"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Turned \u2014 cooperative browser survival on Pinefall Island",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "dependency-cruiser": "^16.9.0",
    "npm-run-all": "^4.1.5"
  }
}
